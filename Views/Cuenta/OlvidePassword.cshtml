@model OlvidePasswordForm
@{
    ViewData["Title"] = "Olvidé mi contraseña";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Olvidé mi contraseña - Traslados Perú</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        body.login-bg {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background:
                linear-gradient(160deg, rgba(6,20,40,0.88), rgba(9,54,94,0.88)),
                repeating-linear-gradient(135deg, #0c2440 0px, #0c2440 40px, #123458 40px, #123458 80px);
            padding: 24px;
        }
        .login-card {
            width: 380px;
            background: white;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 20px 50px rgba(0,0,0,0.35);
        }
        .login-body { padding: 28px 32px 32px; }
        .login-tagline {
            text-align: center;
            color: var(--gris);
            font-size: 0.82rem;
            margin: 0 0 20px;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }
        .ayuda-texto {
            font-size: 0.85rem;
            color: var(--gris);
            margin: 0 0 20px;
        }
    </style>
</head>
<body class="login-bg">
    <div class="login-card">
        <div class="login-body">
            <p class="login-tagline">Restablecer contraseña</p>
            <p class="ayuda-texto">
                Escribe tu DNI. Tu contraseña se va a restablecer automáticamente a tu propio DNI,
                y al iniciar sesión te pedirá crear una nueva.
            </p>

            <div asp-validation-summary="All" class="validation-summary"></div>

            <form asp-controller="Cuenta" asp-action="OlvidePassword" method="post">
                <div class="form-group" style="margin-bottom:20px;">
                    <label>DNI</label>
                    <input asp-for="Dni" class="input" placeholder="Ej: 07452723" autofocus />
                </div>
                <button type="submit" class="btn btn-primary" style="width:100%; margin-bottom:12px;">Restablecer contraseña</button>
                <a href="/Cuenta/Login" class="btn btn-secondary" style="width:100%; display:block; text-align:center; box-sizing:border-box;">Volver a iniciar sesión</a>
            </form>
        </div>
    </div>
</body>
</html>
