@model CambiarPasswordForm
@{
    ViewData["Title"] = "Cambiar contraseña";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Cambiar contraseña - TrasladosPerú</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body style="margin:0; min-height:100vh; display:flex; align-items:center; justify-content:center; padding:24px;
             background: linear-gradient(160deg, rgba(6,20,40,0.88), rgba(9,54,94,0.88)), repeating-linear-gradient(135deg, #0c2440 0px, #0c2440 40px, #123458 40px, #123458 80px);">
    <div class="card" style="width:360px; padding:32px;">
        <h1 style="text-align:center; color:var(--azul-oscuro); font-size:1.3rem; margin-bottom:8px;">🔒 Cambio de contraseña</h1>
        <p style="text-align:center; color:var(--gris); font-size:0.85rem; margin-bottom:20px;">
            Por seguridad, la contraseña debe renovarse cada 7 días.
        </p>

        <div asp-validation-summary="All" class="validation-summary"></div>

        <form asp-controller="Cuenta" asp-action="CambiarPassword" method="post">
            <input type="hidden" asp-for="Dni" />
            <div class="form-group" style="margin-bottom:14px;">
                <label>Contraseña actual</label>
                <input asp-for="PasswordActual" type="password" class="input" autofocus />
            </div>
            <div class="form-group" style="margin-bottom:14px;">
                <label>Contraseña nueva</label>
                <input asp-for="PasswordNueva" type="password" class="input" />
            </div>
            <div class="form-group" style="margin-bottom:20px;">
                <label>Confirmar contraseña nueva</label>
                <input asp-for="PasswordNuevaConfirmar" type="password" class="input" />
            </div>
            <button type="submit" class="btn btn-primary" style="width:100%;">Guardar y volver a entrar</button>
        </form>
    </div>
</body>
</html>
