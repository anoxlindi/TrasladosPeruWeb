@model RutaPlanificadaForm
@{
    ViewData["Title"] = "Editar ruta planificada";
}

<div class="page-header">
    <h1>✏️ Editar ruta #@Model.CodigoPlan</h1>
</div>

<div class="card form-card">
    <div asp-validation-summary="All" class="validation-summary"></div>

    <form asp-controller="Planificacion" asp-action="Editar" method="post">
        <input type="hidden" asp-for="CodigoPlan" />
        <!-- Filtro que estaba aplicado en la lista, para volver con el mismo -->
        <input type="hidden" name="FiltroFechaDesde" value="@(Model.FiltroFechaDesde?.ToString("yyyy-MM-dd"))" />
        <input type="hidden" name="FiltroFechaHasta" value="@(Model.FiltroFechaHasta?.ToString("yyyy-MM-dd"))" />

        <partial name="_Formulario" model="Model" />

        <div class="form-actions">
            <a href="/Planificacion?FechaDesde=@(Model.FiltroFechaDesde?.ToString("yyyy-MM-dd"))&FechaHasta=@(Model.FiltroFechaHasta?.ToString("yyyy-MM-dd"))" class="btn btn-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary">💾 Guardar cambios</button>
        </div>
    </form>
</div>
