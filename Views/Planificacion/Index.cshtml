@model IEnumerable<RutaPlanificadaDto>
@{
    ViewData["Title"] = "Planificar rutas";
    var filtro = (FiltroPlanificacion)ViewBag.Filtro;
    string desde = filtro.FechaDesde?.ToString("yyyy-MM-dd") ?? "";
    string hasta = filtro.FechaHasta?.ToString("yyyy-MM-dd") ?? "";
    bool automatico = ViewBag.WhatsAppAutomatico ?? false;

    var rutas = Model.ToList();
    var hoy = HoraPeru.Hoy;
    var manana = hoy.AddDays(1);
    var lunes = hoy.AddDays(-(((int)hoy.DayOfWeek + 6) % 7));
    var domingo = lunes.AddDays(6);

    string hoyTxt = hoy.ToString("yyyy-MM-dd");
    string mananaTxt = manana.ToString("yyyy-MM-dd");
    string lunesTxt = lunes.ToString("yyyy-MM-dd");
    string domingoTxt = domingo.ToString("yyyy-MM-dd");

    bool esHoy = desde == hoyTxt && hasta == hoyTxt;
    bool esManana = desde == mananaTxt && hasta == mananaTxt;
    bool esSemana = desde == lunesTxt && hasta == domingoTxt;
    bool esAdelante = desde == hoyTxt && hasta == "";

    var diasNombre = new[] { "domingo", "lunes", "martes", "miércoles", "jueves", "viernes", "sábado" };

    int totalRutas = rutas.Count;
    int totalUnidades = rutas.Select(r => r.Placa.Trim()).Distinct().Count();
    int totalPersonal = rutas
        .SelectMany(r => new[] { r.DniChofer?.Trim(), r.DniAyudante?.Trim(), r.DniAyudante2?.Trim() })
        .Where(d => !string.IsNullOrWhiteSpace(d))
        .Distinct()
        .Count();
}

@Html.AntiForgeryToken()

<div class="page-header">
    <h1>🗓️ Planificar rutas</h1>
    <div class="actions">
        <a class="btn btn-primary" href="/Planificacion/Crear">➕ Planificar ruta</a>
        <a class="btn btn-secondary" href="/Planificacion/ExportarExcel?FechaDesde=@desde&FechaHasta=@hasta">📊 Exportar a Excel</a>
    </div>
</div>

<div class="atajos">
    <a class="atajo @(esHoy ? "activo" : "")" href="/Planificacion?FechaDesde=@hoyTxt&FechaHasta=@hoyTxt">☀️ Hoy</a>
    <a class="atajo @(esManana ? "activo" : "")" href="/Planificacion?FechaDesde=@mananaTxt&FechaHasta=@mananaTxt">🌅 Mañana</a>
    <a class="atajo @(esSemana ? "activo" : "")" href="/Planificacion?FechaDesde=@lunesTxt&FechaHasta=@domingoTxt">📆 Esta semana</a>
    <a class="atajo @(esAdelante ? "activo" : "")" href="/Planificacion">⏭️ Hoy en adelante</a>
</div>

<form method="get" class="card filtro-card">
    <div class="form-group">
        <label>📅 Desde</label>
        <input type="date" name="FechaDesde" class="input" value="@desde" />
    </div>
    <div class="form-group">
        <label>📅 Hasta</label>
        <input type="date" name="FechaHasta" class="input" value="@hasta" />
    </div>
    <button type="submit" class="btn btn-primary">🔍 Filtrar</button>
    <div class="form-group buscador">
        <label>🔎 Buscar en la lista</label>
        <input type="search" id="buscador" class="input" placeholder="Cliente, chofer, ayudante, placa o distrito..." autocomplete="off" />
    </div>
</form>

@if (!rutas.Any())
{
    <div class="vacio">
        <div class="vacio-emoji">🚛</div>
        <p>No hay rutas planificadas en estas fechas.</p>
        <a class="btn btn-primary" href="/Planificacion/Crear">➕ Arma la primera ruta</a>
    </div>
}
else
{
    <div class="resumen">
        <span class="resumen-item">📋 <strong>@totalRutas</strong> @(totalRutas == 1 ? "ruta" : "rutas")</span>
        <span class="resumen-item">🚚 <strong>@totalUnidades</strong> @(totalUnidades == 1 ? "unidad" : "unidades")</span>
        <span class="resumen-item">👷 <strong>@totalPersonal</strong> @(totalPersonal == 1 ? "trabajador" : "trabajadores")</span>
        <span class="resumen-item" id="resumenEnviados">✅ <strong>0</strong> mensajes enviados</span>
    </div>

    @foreach (var dia in rutas.GroupBy(r => r.Fecha.Date))
    {
        var etiquetaDia = dia.Key == hoy ? " · ☀️ hoy" : (dia.Key == manana ? " · 🌅 mañana" : "");

        <section class="dia-grupo">
            <h2 class="dia-titulo">📅 @(diasNombre[(int)dia.Key.DayOfWeek] + " " + dia.Key.ToString("dd/MM/yyyy") + etiquetaDia)</h2>

            @foreach (var r in dia)
            {
                var tieneAyudante = !string.IsNullOrWhiteSpace(r.Ayudante);
                var tieneAyudante2 = !string.IsNullOrWhiteSpace(r.Ayudante2);
                var mensajeChofer = MensajesRuta.Construir(r, "chofer");
                var mensajeAyudante = tieneAyudante ? MensajesRuta.Construir(r, "ayudante1") : "";
                var mensajeAyudante2 = tieneAyudante2 ? MensajesRuta.Construir(r, "ayudante2") : "";

                var chofer = new PersonaRutaVm
                {
                    CodigoPlan = r.CodigoPlan,
                    Destino = "chofer",
                    Etiqueta = "🚛 Chofer",
                    Nombre = r.Chofer ?? "—",
                    Link = MensajesRuta.LinkWhatsApp(r.TelefonoChofer, mensajeChofer),
                    Mensaje = mensajeChofer,
                    Automatico = automatico
                };

                var ayudante = new PersonaRutaVm
                {
                    CodigoPlan = r.CodigoPlan,
                    Destino = "ayudante1",
                    Etiqueta = "🧰 Ayudante 1",
                    Nombre = r.Ayudante ?? "—",
                    Link = tieneAyudante ? MensajesRuta.LinkWhatsApp(r.TelefonoAyudante, mensajeAyudante) : null,
                    Mensaje = mensajeAyudante,
                    Automatico = automatico
                };

                var ayudante2 = new PersonaRutaVm
                {
                    CodigoPlan = r.CodigoPlan,
                    Destino = "ayudante2",
                    Etiqueta = "🧰 Ayudante 2",
                    Nombre = r.Ayudante2 ?? "—",
                    Link = tieneAyudante2 ? MensajesRuta.LinkWhatsApp(r.TelefonoAyudante2, mensajeAyudante2) : null,
                    Mensaje = mensajeAyudante2,
                    Automatico = automatico
                };

                var textoBusqueda = $"{r.Cliente} {r.Chofer} {r.Ayudante} {r.Ayudante2} {r.Placa} {r.PuntoInicio} {r.PuntoFin} {r.Direccion}".ToLowerInvariant();

                <article class="ruta-card @(r.EsDoblete ? "ruta-doblete" : "")" data-buscar="@textoBusqueda">
                    <div class="ruta-horas">
                        <div class="hora-bloque">
                            <span class="hora-etiqueta">⏰ Salida</span>
                            <span class="hora-grande">@($"{r.HoraSalidaCochera.Hours:00}:{r.HoraSalidaCochera.Minutes:00}")</span>
                        </div>
                        <div class="hora-bloque">
                            <span class="hora-etiqueta">🤝 Cita</span>
                            <span class="hora-cita">@(r.HoraCita.HasValue ? $"{r.HoraCita.Value.Hours:00}:{r.HoraCita.Value.Minutes:00}" : "—")</span>
                        </div>
                    </div>

                    <div class="ruta-info">
                        @if (r.EsDoblete)
                        {
                            <span class="chip chip-doblete">🔁 Doblete</span>
                        }
                        <div class="ruta-cliente">🏢 @(r.Cliente ?? "—")</div>
                        <div class="ruta-trayecto">📍 @r.PuntoInicio <span class="flecha">➜</span> @r.PuntoFin</div>
                        @if (!string.IsNullOrWhiteSpace(r.Direccion))
                        {
                            <div class="ruta-detalle">📌 @r.Direccion</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(r.Observaciones))
                        {
                            <div class="ruta-detalle">📝 @r.Observaciones</div>
                        }
                        <span class="chip">🚚 @r.Placa.Trim()</span>
                    </div>

                    <div class="ruta-personas">
                        <partial name="_PersonaRuta" model="chofer" />
                        @if (tieneAyudante)
                        {
                            <partial name="_PersonaRuta" model="ayudante" />
                        }
                        else
                        {
                            <div class="persona persona-vacia">🧰 Sin ayudante</div>
                        }
                        @if (tieneAyudante2)
                        {
                            <partial name="_PersonaRuta" model="ayudante2" />
                        }
                    </div>

                    <div class="ruta-acciones">
                        <a href="/Planificacion/Editar/@(r.CodigoPlan)?fechaDesde=@(desde)&fechaHasta=@(hasta)" class="btn-icon" title="Editar ruta">✏️</a>
                        <form asp-controller="Planificacion" asp-action="Eliminar" asp-route-id="@r.CodigoPlan"
                              asp-route-fechaDesde="@desde" asp-route-fechaHasta="@hasta" method="post"
                              onsubmit="return confirm('¿Eliminar esta ruta planificada?');" style="display:inline;">
                            <button type="submit" class="btn-icon" title="Eliminar">🗑️</button>
                        </form>
                    </div>
                </article>
            }
        </section>
    }

    <p class="empty-state" id="sinResultados" style="display:none;">🔎 Ninguna ruta coincide con lo que escribiste.</p>
}

<div id="aviso" class="aviso" role="status"></div>

<script>
    // ---------- Aviso flotante ----------
    var avisoTimer = null;
    function mostrarAviso(texto, esError) {
        var aviso = document.getElementById('aviso');
        aviso.textContent = texto;
        aviso.className = 'aviso visible' + (esError ? ' error' : '');
        clearTimeout(avisoTimer);
        avisoTimer = setTimeout(function () { aviso.className = 'aviso'; }, 2500);
    }

    // ---------- Recordar a quien ya se le envio (solo en este navegador) ----------
    function yaEnviado(clave) {
        try { return localStorage.getItem('enviado:' + clave) === '1'; } catch (e) { return false; }
    }
    function guardarEnviado(clave) {
        try { localStorage.setItem('enviado:' + clave, '1'); } catch (e) { }
    }
    function marcarEnviado(boton) {
        boton.classList.add('enviado');
        boton.innerText = '✅ Enviado';
        boton.title = 'Ya enviado. Haz clic otra vez si quieres volver a enviarlo.';
        actualizarContador();
    }
    function actualizarContador() {
        var total = document.querySelectorAll('.btn-wa.enviado').length;
        var cont = document.getElementById('resumenEnviados');
        if (cont) cont.innerHTML = '✅ <strong>' + total + '</strong> ' + (total === 1 ? 'mensaje enviado' : 'mensajes enviados');
    }

    document.querySelectorAll('.btn-wa').forEach(function (boton) {
        var clave = boton.getAttribute('data-clave');
        if (yaEnviado(clave)) marcarEnviado(boton);
    });
    actualizarContador();

    // Envio con link directo (abre la app de WhatsApp): se marca al hacer clic
    document.querySelectorAll('a.btn-wa').forEach(function (enlace) {
        enlace.addEventListener('click', function () {
            guardarEnviado(enlace.getAttribute('data-clave'));
            marcarEnviado(enlace);
        });
    });

    // Envio automatico (API): manda el mensaje sin salir de esta pagina
    document.querySelectorAll('button.btn-enviar').forEach(function (boton) {
        boton.addEventListener('click', function () {
            if (boton.disabled) return;
            var original = boton.innerText;
            boton.disabled = true;
            boton.innerText = '⏳ Enviando...';

            var datos = new URLSearchParams();
            datos.append('id', boton.getAttribute('data-id'));
            datos.append('destino', boton.getAttribute('data-destino'));
            datos.append('__RequestVerificationToken',
                document.querySelector('input[name="__RequestVerificationToken"]').value);

            fetch('/Planificacion/EnviarWhatsApp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: datos
            })
            .then(function (respuesta) { return respuesta.json(); })
            .then(function (resultado) {
                boton.disabled = false;
                if (resultado.ok) {
                    guardarEnviado(boton.getAttribute('data-clave'));
                    marcarEnviado(boton);
                    mostrarAviso('✅ Mensaje enviado');
                } else {
                    boton.innerText = original;
                    mostrarAviso('❌ No se pudo enviar: ' + resultado.mensaje, true);
                }
            })
            .catch(function () {
                boton.disabled = false;
                boton.innerText = original;
                mostrarAviso('❌ No se pudo enviar. Revisa tu conexión o vuelve a iniciar sesión.', true);
            });
        });
    });

    // ---------- Copiar mensaje ----------
    document.querySelectorAll('.btn-copiar').forEach(function (boton) {
        boton.addEventListener('click', function () {
            var texto = boton.getAttribute('data-mensaje') || '';
            function listo() { mostrarAviso('📋 Mensaje copiado'); }
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(texto).then(listo);
            } else {
                var area = document.createElement('textarea');
                area.value = texto;
                document.body.appendChild(area);
                area.select();
                document.execCommand('copy');
                document.body.removeChild(area);
                listo();
            }
        });
    });

    // ---------- Buscador en vivo ----------
    var buscador = document.getElementById('buscador');
    if (buscador) {
        buscador.addEventListener('input', function () {
            var texto = buscador.value.trim().toLowerCase();
            var visibles = 0;
            document.querySelectorAll('.ruta-card').forEach(function (tarjeta) {
                var coincide = texto === '' || (tarjeta.getAttribute('data-buscar') || '').indexOf(texto) !== -1;
                tarjeta.style.display = coincide ? '' : 'none';
                if (coincide) visibles++;
            });
            document.querySelectorAll('.dia-grupo').forEach(function (grupo) {
                var hay = grupo.querySelectorAll('.ruta-card:not([style*="display: none"])').length > 0;
                grupo.style.display = hay ? '' : 'none';
            });
            var aviso = document.getElementById('sinResultados');
            if (aviso) aviso.style.display = visibles === 0 ? 'block' : 'none';
        });
    }
</script>
