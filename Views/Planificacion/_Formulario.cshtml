@model RutaPlanificadaForm
@{
    var clientes = (IEnumerable<OpcionSelect>)ViewBag.Clientes;
    var choferes = (IEnumerable<OpcionSelect>)ViewBag.Choferes;
    var ayudantes = (IEnumerable<OpcionSelect>)ViewBag.Ayudantes;
    var unidades = (IEnumerable<OpcionSelect>)ViewBag.Unidades;
    var distritos = (string[])ViewBag.Distritos;
    var distritosDestino = (string[])ViewBag.DistritosDestino;

    string horaSalida = Model.HoraSalidaCochera.HasValue
        ? $"{Model.HoraSalidaCochera.Value.Hours:00}:{Model.HoraSalidaCochera.Value.Minutes:00}" : "";
    string horaCita = Model.HoraCita.HasValue
        ? $"{Model.HoraCita.Value.Hours:00}:{Model.HoraCita.Value.Minutes:00}" : "";
    string horaSalida2 = Model.HoraSalidaCochera2.HasValue
        ? $"{Model.HoraSalidaCochera2.Value.Hours:00}:{Model.HoraSalidaCochera2.Value.Minutes:00}" : "";
    string horaCita2 = Model.HoraCita2.HasValue
        ? $"{Model.HoraCita2.Value.Hours:00}:{Model.HoraCita2.Value.Minutes:00}" : "";
}

<h3 class="seccion">📅 Fecha y horarios</h3>
<div class="form-grid">
    <div class="form-group">
        <label>📅 Fecha de la ruta</label>
        <input asp-for="Fecha" type="date" class="input" value="@(Model.Fecha.ToString("yyyy-MM-dd"))" />
    </div>

    <div class="form-group">
        <label>⏰ Hora de salida de cochera</label>
        <input asp-for="HoraSalidaCochera" type="time" class="input" value="@horaSalida" />
    </div>

    <div class="form-group">
        <label>🤝 Hora de la cita (opcional)</label>
        <input asp-for="HoraCita" type="time" class="input" value="@horaCita" />
    </div>

    <div class="form-group form-check-group">
        <label class="check-label">
            <input asp-for="EsDoblete" type="checkbox" class="check" value="true" id="chkDoblete" />
            🔁 Esta ruta es doblete (el chofer tiene otro viaje ese día)
        </label>
    </div>
</div>

<h3 class="seccion">🏢 Cliente</h3>
<div class="form-grid">
    <div class="form-group">
        <label>🏢 Cliente</label>
        <select asp-for="Ruc" class="input" onchange="document.getElementById('otroClienteBox').style.display = this.value === '' ? 'block' : 'none';">
            <option value="">-- Otro (escribir abajo) --</option>
            @foreach (var c in clientes)
            {
                <option value="@c.Codigo">@c.Texto</option>
            }
        </select>
    </div>

    <div class="form-group" id="otroClienteBox">
        <label>Si es "Otro", escribe el nombre del cliente</label>
        <input asp-for="ClienteOtro" class="input" placeholder="Nombre de la empresa" />
    </div>
</div>

<h3 class="seccion">🚚 Unidad y personal</h3>
<div class="form-grid">
    <div class="form-group">
        <label>🚚 Unidad (placa)</label>
        <select asp-for="CodigoUnidad" class="input">
            <option value="">-- Selecciona --</option>
            @foreach (var u in unidades)
            {
                <option value="@u.Codigo">@u.Texto</option>
            }
        </select>
    </div>

    <div class="form-group">
        <label>🚛 Chofer</label>
        <select asp-for="DniChofer" class="input">
            <option value="">-- Selecciona --</option>
            @foreach (var c in choferes)
            {
                <option value="@c.Codigo">@c.Texto</option>
            }
        </select>
    </div>

    <div class="form-group">
        <label>🧰 Ayudante 1</label>
        <select asp-for="DniAyudante" class="input">
            <option value="">-- Sin ayudante --</option>
            @foreach (var a in ayudantes)
            {
                <option value="@a.Codigo">@a.Texto</option>
            }
        </select>
    </div>

    <div class="form-group">
        <label>🧰 Ayudante 2 (opcional)</label>
        <select asp-for="DniAyudante2" class="input">
            <option value="">-- Sin segundo ayudante --</option>
            @foreach (var a in ayudantes)
            {
                <option value="@a.Codigo">@a.Texto</option>
            }
        </select>
        <span class="ayuda-campo">Un chofer también puede ir como ayudante: aparece en la misma lista.</span>
    </div>
</div>

<h3 class="seccion">📍 Lugar</h3>
<div class="form-grid">
    <div class="form-group">
        <label>📍 Punto de inicio</label>
        <select asp-for="PuntoInicio" class="input">
            <option value="">-- Selecciona un distrito --</option>
            @foreach (var d in distritos)
            {
                <option value="@d">@d</option>
            }
        </select>
    </div>

    <div class="form-group">
        <label>🏁 Punto final</label>
        <select id="selPuntoFin" class="input">
            <option value="">-- Selecciona un distrito --</option>
            @foreach (var d in distritosDestino)
            {
                <option value="@d">@d</option>
            }
            <option value="__otros__">Otros (escribir)</option>
        </select>
        <input type="text" id="txtPuntoFinOtro" class="input" maxlength="60"
               placeholder="Escribe el punto de llegada" style="display:none; margin-top:6px;" />
        <input asp-for="PuntoFin" type="hidden" id="PuntoFin" />
        <span class="ayuda-campo">Si es reparto a varios puntos, elige "Varios / Reparto". Si no coincide con ningún distrito, elige "Otros" y escríbelo.</span>
    </div>

    <div class="form-group">
        <label>📌 Dirección exacta de la cita (opcional)</label>
        <input asp-for="Direccion" class="input" maxlength="150" placeholder="Ej: Av. Industrial 123, Lurín" />
    </div>

    <div class="form-group">
        <label>📝 Observaciones (opcional)</label>
        <input asp-for="Observaciones" class="input" maxlength="300" placeholder="Ej: llevar guías de remisión" />
    </div>
</div>

<div id="bloqueViaje2" class="bloque-viaje2">
    <h3 class="seccion">🔁 Viaje 2 (doblete)</h3>
    <div class="form-grid">
        <div class="form-group">
            <label>⏰ Hora de salida (2do viaje)</label>
            <input asp-for="HoraSalidaCochera2" type="time" class="input" value="@horaSalida2" />
        </div>

        <div class="form-group">
            <label>🤝 Hora de la cita (2do viaje, opcional)</label>
            <input asp-for="HoraCita2" type="time" class="input" value="@horaCita2" />
        </div>

        <div class="form-group">
            <label>🏢 Cliente (2do viaje)</label>
            <select asp-for="Ruc2" class="input" onchange="document.getElementById('otroClienteBox2').style.display = this.value === '' ? 'block' : 'none';">
                <option value="">-- Otro (escribir abajo) --</option>
                @foreach (var c in clientes)
                {
                    <option value="@c.Codigo">@c.Texto</option>
                }
            </select>
        </div>

        <div class="form-group" id="otroClienteBox2">
            <label>Si es "Otro", escribe el nombre del cliente (2do viaje)</label>
            <input asp-for="ClienteOtro2" class="input" placeholder="Nombre de la empresa" />
        </div>

        <div class="form-group">
            <label>📍 Punto de inicio (2do viaje)</label>
            <select asp-for="PuntoInicio2" class="input">
                <option value="">-- Selecciona un distrito --</option>
                @foreach (var d in distritos)
                {
                    <option value="@d">@d</option>
                }
            </select>
        </div>

        <div class="form-group">
            <label>🏁 Punto final (2do viaje)</label>
            <select id="selPuntoFin2" class="input">
                <option value="">-- Selecciona un distrito --</option>
                @foreach (var d in distritosDestino)
                {
                    <option value="@d">@d</option>
                }
                <option value="__otros__">Otros (escribir)</option>
            </select>
            <input type="text" id="txtPuntoFin2Otro" class="input" maxlength="60"
                   placeholder="Escribe el punto de llegada" style="display:none; margin-top:6px;" />
            <input asp-for="PuntoFin2" type="hidden" id="PuntoFin2" />
        </div>

        <div class="form-group">
            <label>📌 Dirección exacta (2do viaje, opcional)</label>
            <input asp-for="Direccion2" class="input" maxlength="150" placeholder="Ej: Av. Industrial 123, Lurín" />
        </div>
    </div>
    <span class="ayuda-campo">El chofer y la unidad son los mismos del viaje 1. Esto se agrega como "Viaje 2" en su mensaje de WhatsApp.</span>
</div>

<script>
    // Respaldo: deja marcado en cada lista lo que ya tenia la ruta (al editar)
    (function () {
        function marcar(nombre, valor) {
            if (valor === null || valor === undefined || valor === "") return;
            var el = document.querySelector('select[name="' + nombre + '"]');
            if (el) el.value = String(valor);
        }
        marcar("Ruc", "@Model.Ruc");
        marcar("CodigoUnidad", "@(Model.CodigoUnidad > 0 ? Model.CodigoUnidad.ToString() : "")");
        marcar("DniChofer", "@Model.DniChofer");
        marcar("DniAyudante", "@Model.DniAyudante");
        marcar("DniAyudante2", "@Model.DniAyudante2");
        marcar("PuntoInicio", "@Model.PuntoInicio");
        marcar("Ruc2", "@Model.Ruc2");
        marcar("PuntoInicio2", "@Model.PuntoInicio2");

        var otroBox = document.getElementById('otroClienteBox');
        var rucSelect = document.querySelector('select[name="Ruc"]');
        if (otroBox && rucSelect) {
            otroBox.style.display = rucSelect.value === "" ? "block" : "none";
        }
        var otroBox2 = document.getElementById('otroClienteBox2');
        var rucSelect2 = document.querySelector('select[name="Ruc2"]');
        if (otroBox2 && rucSelect2) {
            otroBox2.style.display = rucSelect2.value === "" ? "block" : "none";
        }

        // Muestra u oculta el bloque "Viaje 2" segun la casilla de doblete
        var chkDoblete = document.getElementById('chkDoblete');
        var bloqueViaje2 = document.getElementById('bloqueViaje2');
        function actualizarBloqueViaje2() {
            bloqueViaje2.style.display = chkDoblete.checked ? 'block' : 'none';
        }
        if (chkDoblete && bloqueViaje2) {
            chkDoblete.addEventListener('change', actualizarBloqueViaje2);
            actualizarBloqueViaje2();
        }

        // Punto final: si el distrito no esta en la lista, se puede escribir libremente ("Otros")
        function configurarPuntoLibre(selId, cajaId, ocultoId, valorInicial) {
            var sel = document.getElementById(selId);
            var caja = document.getElementById(cajaId);
            var oculto = document.getElementById(ocultoId);
            if (!sel || !caja || !oculto) return;

            function mostrarCaja(mostrar) { caja.style.display = mostrar ? 'block' : 'none'; }

            sel.addEventListener('change', function () {
                if (sel.value === '__otros__') {
                    mostrarCaja(true);
                    oculto.value = caja.value;
                    caja.focus();
                } else {
                    mostrarCaja(false);
                    oculto.value = sel.value;
                }
            });
            caja.addEventListener('input', function () { oculto.value = caja.value; });

            if (valorInicial) {
                sel.value = valorInicial;
                if (sel.value !== valorInicial) {
                    sel.value = '__otros__';
                    caja.value = valorInicial;
                    mostrarCaja(true);
                }
                oculto.value = valorInicial;
            }
        }
        configurarPuntoLibre('selPuntoFin', 'txtPuntoFinOtro', 'PuntoFin', "@Model.PuntoFin");
        configurarPuntoLibre('selPuntoFin2', 'txtPuntoFin2Otro', 'PuntoFin2', "@Model.PuntoFin2");
    })();
</script>

<div class="vista-previa">
    <h4>👀 Así se verá la ruta</h4>
    <ul id="vistaPrevia"></ul>
</div>

<script>
    // Vista previa en vivo: se actualiza mientras se llena el formulario
    (function () {
        function campo(nombre) { return document.querySelector('[name="' + nombre + '"]'); }
        function valor(nombre) { var el = campo(nombre); return el ? el.value : ''; }
        function textoSeleccionado(nombre) {
            var el = campo(nombre);
            if (!el || el.value === '' || el.selectedIndex < 0) return '';
            return el.options[el.selectedIndex].text;
        }

        function actualizar() {
            var cliente = textoSeleccionado('Ruc') || valor('ClienteOtro');
            var doblete = document.querySelector('input[name="EsDoblete"]');
            var esDoblete = doblete && doblete.checked;
            var lineas = [
                ['📅', 'Fecha', valor('Fecha')],
                ['⏰', 'Salida de cochera', valor('HoraSalidaCochera')],
                ['🤝', 'Cita', valor('HoraCita')],
                ['🔁', 'Doblete', esDoblete ? 'Sí' : ''],
                ['🏢', 'Cliente', cliente],
                ['🚚', 'Unidad', textoSeleccionado('CodigoUnidad')],
                ['🚛', 'Chofer', textoSeleccionado('DniChofer')],
                ['🧰', 'Ayudante 1', textoSeleccionado('DniAyudante')],
                ['🧰', 'Ayudante 2', textoSeleccionado('DniAyudante2')],
                ['📍', 'Ruta', (valor('PuntoInicio') || '?') + ' ➜ ' + (valor('PuntoFin') || '?')],
                ['📌', 'Dirección', valor('Direccion')],
                ['📝', 'Nota', valor('Observaciones')]
            ];
            if (esDoblete) {
                var cliente2 = textoSeleccionado('Ruc2') || valor('ClienteOtro2');
                lineas.push(['⏰', 'Viaje 2 - Salida', valor('HoraSalidaCochera2')]);
                lineas.push(['🤝', 'Viaje 2 - Cita', valor('HoraCita2')]);
                lineas.push(['🏢', 'Viaje 2 - Cliente', cliente2]);
                lineas.push(['📍', 'Viaje 2 - Ruta', (valor('PuntoInicio2') || '?') + ' ➜ ' + (valor('PuntoFin2') || '?')]);
            }
            var lista = document.getElementById('vistaPrevia');
            lista.innerHTML = '';
            lineas.forEach(function (l) {
                if (l[2] === '') return;
                var li = document.createElement('li');
                li.textContent = l[0] + ' ' + l[1] + ': ' + l[2];
                lista.appendChild(li);
            });
            if (!lista.children.length) {
                var vacio = document.createElement('li');
                vacio.textContent = 'Completa los datos y aquí verás el resumen.';
                lista.appendChild(vacio);
            }
        }

        document.querySelectorAll('input, select').forEach(function (el) {
            el.addEventListener('input', actualizar);
            el.addEventListener('change', actualizar);
        });
        actualizar();
    })();
</script>
