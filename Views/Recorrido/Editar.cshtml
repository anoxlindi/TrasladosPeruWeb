@model NuevoViajeForm
@{
    ViewData["Title"] = "Editar viaje";
    var clientes = (IEnumerable<OpcionSelect>)ViewBag.Clientes;
    var choferes = (IEnumerable<OpcionSelect>)ViewBag.Choferes;
    var ayudantes = (IEnumerable<OpcionSelect>)ViewBag.Ayudantes;
    var unidades = (IEnumerable<OpcionSelect>)ViewBag.Unidades;
    var tiposCarga = (string[])ViewBag.TiposCarga;
    var distritos = (string[])ViewBag.Distritos;
}

<div class="page-header">
    <h1>Editar viaje #@Model.CodigoRecorrido</h1>
</div>

<div class="card form-card">
    <div asp-validation-summary="All" class="validation-summary"></div>

    <form asp-controller="Recorrido" asp-action="Editar" method="post">
        <input type="hidden" asp-for="CodigoRecorrido" />

        <!-- Campos ocultos: guardan el filtro que estaba aplicado en Index, para que al
             Guardar, el redirect vuelva a Index con el MISMO filtro (no se resetea). -->
        <input type="hidden" asp-for="FiltroFechaDesde" />
        <input type="hidden" asp-for="FiltroFechaHasta" />
        <input type="hidden" asp-for="FiltroDniChofer" />
        <input type="hidden" asp-for="FiltroCodigoUnidad" />

        <h3 class="seccion">Personal y unidad</h3>
        <div class="form-grid">
            <div class="form-group">
                <label>Chofer</label>
                <select asp-for="DniChofer" class="input">
                    <option value="">-- Selecciona --</option>
                    @foreach (var c in choferes)
                    {
                        <option value="@c.Codigo">@c.Texto</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label>Ayudante</label>
                <select asp-for="DniAyudante" class="input">
                    <option value="">-- Sin ayudante (chofer solo) --</option>
                    @foreach (var a in ayudantes)
                    {
                        <option value="@a.Codigo">@a.Texto</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label>Unidad (placa)</label>
                <select asp-for="CodigoUnidad" class="input">
                    <option value="">-- Selecciona --</option>
                    @foreach (var u in unidades)
                    {
                        <option value="@u.Codigo">@u.Texto</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label>Cliente</label>
                <select asp-for="Ruc" class="input" onchange="document.getElementById('otroClienteBox').style.display = this.value === '' ? 'block' : 'none';">
                    <option value="">-- Otro (escribir abajo) --</option>
                    @foreach (var c in clientes)
                    {
                        <option value="@c.Codigo">@c.Texto</option>
                    }
                </select>
            </div>

            <div class="form-group" id="otroClienteBox">
                <label>Si es "Otro", escribe el nombre del cliente</label>
                <input asp-for="ClienteOtro" class="input" placeholder="Nombre de la empresa" />
            </div>
        </div>

        <h3 class="seccion">Costo</h3>
        <div class="form-grid">
            <div class="form-group">
                <label>Costo del servicio (S/)</label>
                <input asp-for="Costo" type="number" step="0.01" class="input" placeholder="Ej: 350.00" />
            </div>

            <div class="form-group">
                <label>Costo adicional (S/)</label>
                <input asp-for="CostoAdicional" type="number" step="0.01" class="input" placeholder="Ej: 50.00" />
            </div>
        </div>

        <h3 class="seccion">Carga</h3>
        <div class="form-grid">
            <div class="form-group">
                <label>Tipo de carga</label>
                <select asp-for="TipoCargamento" class="input">
                    <option value="">-- Selecciona --</option>
                    @foreach (var t in tiposCarga)
                    {
                        <option value="@t">@t</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label>Peso (kg)</label>
                <input asp-for="Peso" type="number" step="0.01" class="input" />
            </div>
        </div>

        <h3 class="seccion">Ruta</h3>
        <div class="form-grid">
            <div class="form-group">
                <label>Punto de inicio</label>
                <select asp-for="PuntoInicio" class="input">
                    <option value="">-- Selecciona un distrito --</option>
                    @foreach (var d in distritos)
                    {
                        <option value="@d">@d</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label>Punto final</label>
                <select asp-for="PuntoFin" class="input">
                    <option value="">-- Selecciona un distrito --</option>
                    @foreach (var d in distritos)
                    {
                        <option value="@d">@d</option>
                    }
                </select>
            </div>
        </div>

        <h3 class="seccion">Horarios y kilometraje</h3>
        <div class="form-grid">
            <div class="form-group">
                <label>Fecha y hora de inicio</label>
                <input asp-for="FechaInicio" type="datetime-local" class="input" min="2025-01-01T00:00" />
            </div>

            <div class="form-group">
                <label>Fecha y hora de fin</label>
                <input asp-for="FechaFin" type="datetime-local" class="input" min="2025-01-01T00:00" />
            </div>

            <div class="form-group">
                <label>Kilometraje de inicio de cochera</label>
                <input asp-for="KilometrajeInicioCochera" type="number" class="input" />
            </div>

            <div class="form-group">
                <label>Kilometraje final de cochera</label>
                <input asp-for="KilometrajeFinalCochera" type="number" class="input" />
            </div>

            <div class="form-group">
                <label>Kilometraje inicial (del servicio)</label>
                <input asp-for="KilometrajeInicial" type="number" class="input" />
            </div>

            <div class="form-group">
                <label>Kilometraje final (del servicio)</label>
                <input asp-for="KilometrajeFinal" type="number" class="input" />
            </div>
        </div>

        <h3 class="seccion">Peaje</h3>
        <div class="form-grid">
            <div class="form-group">
                <label>¿Fuiste por peaje?</label>
                <div style="display:flex; gap:20px; margin-top:6px;">
                    <label style="font-weight:normal;"><input type="radio" name="FuePeaje" value="true" id="peajeSi" /> Sí</label>
                    <label style="font-weight:normal;"><input type="radio" name="FuePeaje" value="false" id="peajeNo" /> No</label>
                </div>
            </div>

            <div class="form-group" id="peajeCantidadBox">
                <label>¿Por cuántos peajes pasó? <span id="peajeCantidadValor">@Model.CantidadPeajes</span></label>
                <input asp-for="CantidadPeajes" type="range" min="1" max="4" step="1" class="input" oninput="document.getElementById('peajeCantidadValor').innerText = this.value;" />
            </div>
        </div>

        <h3 class="seccion">Línea amarilla</h3>
        <div class="form-grid">
            <div class="form-group">
                <label>¿Pasaste por línea amarilla?</label>
                <div style="display:flex; gap:20px; margin-top:6px;">
                    <label style="font-weight:normal;"><input type="radio" name="FueLineaAmarilla" value="true" id="lineaSi" /> Sí</label>
                    <label style="font-weight:normal;"><input type="radio" name="FueLineaAmarilla" value="false" id="lineaNo" /> No</label>
                </div>
            </div>

            <div class="form-group" id="lineaCantidadBox">
                <label>¿Por cuántas líneas amarillas pasó? <span id="lineaCantidadValor">@Model.CantidadLineaAmarilla</span></label>
                <input asp-for="CantidadLineaAmarilla" type="range" min="1" max="4" step="1" class="input" oninput="document.getElementById('lineaCantidadValor').innerText = this.value;" />
            </div>
        </div>

        <div class="form-actions">
            <a href="/Recorrido" class="btn btn-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary">Guardar cambios</button>
        </div>
    </form>
</div>

<script>
    // Preselecciona en cada <select> el valor que ya tenia el viaje
    (function () {
        function marcar(nombre, valor) {
            if (valor === null || valor === undefined || valor === "") return;
            var el = document.querySelector('select[name="' + nombre + '"]');
            if (el) el.value = String(valor);
        }
        marcar("DniChofer", "@Model.DniChofer");
        marcar("DniAyudante", "@Model.DniAyudante");
        marcar("CodigoUnidad", "@Model.CodigoUnidad");
        marcar("Ruc", "@Model.Ruc");
        marcar("TipoCargamento", "@Model.TipoCargamento");
        marcar("PuntoInicio", "@Model.PuntoInicio");
        marcar("PuntoFin", "@Model.PuntoFin");

        var otroBox = document.getElementById('otroClienteBox');
        var rucSelect = document.querySelector('select[name="Ruc"]');
        if (otroBox && rucSelect) {
            otroBox.style.display = rucSelect.value === "" ? "block" : "none";
        }
    })();

    // Marca el radio Si/No de peaje y linea amarilla segun el valor guardado
    (function () {
        document.getElementById(@Html.Raw(Model.FuePeaje ? "'peajeSi'" : "'peajeNo'")).checked = true;
        document.getElementById(@Html.Raw(Model.FueLineaAmarilla ? "'lineaSi'" : "'lineaNo'")).checked = true;

        function actualizarPeaje() {
            document.getElementById('peajeCantidadBox').style.display =
                document.getElementById('peajeSi').checked ? 'block' : 'none';
        }
        function actualizarLinea() {
            document.getElementById('lineaCantidadBox').style.display =
                document.getElementById('lineaSi').checked ? 'block' : 'none';
        }
        document.getElementById('peajeSi').addEventListener('change', actualizarPeaje);
        document.getElementById('peajeNo').addEventListener('change', actualizarPeaje);
        document.getElementById('lineaSi').addEventListener('change', actualizarLinea);
        document.getElementById('lineaNo').addEventListener('change', actualizarLinea);
        actualizarPeaje();
        actualizarLinea();
    })();
</script>
