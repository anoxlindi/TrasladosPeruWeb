@model NuevoViajeForm
@{
    ViewData["Title"] = "Nuevo viaje";
    var clientes = (IEnumerable<OpcionSelect>)ViewBag.Clientes;
    var choferes = (IEnumerable<OpcionSelect>)ViewBag.Choferes;
    var ayudantes = (IEnumerable<OpcionSelect>)ViewBag.Ayudantes;
    var unidades = (IEnumerable<OpcionSelect>)ViewBag.Unidades;
    var tiposCarga = (string[])ViewBag.TiposCarga;
    var distritos = (string[])ViewBag.Distritos;
    bool esAdmin = ViewBag.EsAdmin ?? false;
    string miDni = ViewBag.MiDni ?? "";
    string miNombre = ViewBag.MiNombre ?? "";
    string? miRol = ViewBag.MiRol;
}

<div class="page-header">
    <h1>Nuevo viaje</h1>
</div>

<div class="card form-card">
    <div asp-validation-summary="All" class="validation-summary"></div>

    <form asp-controller="Recorrido" asp-action="Crear" method="post">
        <h3 class="seccion">Personal y unidad</h3>
        <div class="form-grid">
            <div class="form-group">
                <label>Chofer</label>
                @if (esAdmin || miRol == "Ayudante")
                {
                    <select asp-for="DniChofer" class="input">
                        <option value="">-- Selecciona --</option>
                        @foreach (var c in choferes)
                        {
                            <option value="@c.Codigo">@c.Texto</option>
                        }
                    </select>
                }
                else
                {
                    <input class="input" value="@miNombre" disabled />
                    <input type="hidden" asp-for="DniChofer" value="@miDni" />
                }
            </div>

            <div class="form-group">
                <label>Ayudante</label>
                @if (esAdmin || miRol == "Chofer")
                {
                    <select asp-for="DniAyudante" class="input">
                        <option value="">-- Sin ayudante (chofer solo) --</option>
                        @foreach (var a in ayudantes)
                        {
                            <option value="@a.Codigo">@a.Texto</option>
                        }
                    </select>
                }
                else
                {
                    <input class="input" value="@miNombre" disabled />
                    <input type="hidden" asp-for="DniAyudante" value="@miDni" />
                }
            </div>

            <div class="form-group">
                <label>Unidad (placa)</label>
                <select asp-for="CodigoUnidad" class="input">
                    <option value="">-- Selecciona --</option>
                    @foreach (var u in unidades)
                    {
                        <option value="@u.Codigo">@u.Texto</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label>Cliente</label>
                <select asp-for="Ruc" class="input" onchange="document.getElementById('otroClienteBox').style.display = this.value === '' ? 'block' : 'none';">
                    <option value="">-- Otro (escribir abajo) --</option>
                    @foreach (var c in clientes)
                    {
                        <option value="@c.Codigo">@c.Texto</option>
                    }
                </select>
            </div>

            <div class="form-group" id="otroClienteBox">
                <label>Si es "Otro", escribe el nombre del cliente</label>
                <input asp-for="ClienteOtro" class="input" placeholder="Nombre de la empresa" />
            </div>
        </div>

        <h3 class="seccion">Costo</h3>
        <div class="form-grid">
            <div class="form-group">
                <label>Costo del servicio (S/)</label>
                @if (esAdmin)
                {
                    <input asp-for="Costo" type="number" step="0.01" class="input" placeholder="Ej: 350.00" />
                }
                else
                {
                    <input class="input" value="Solo Gina puede fijar el costo" disabled />
                }
            </div>

            <div class="form-group">
                <label>Costo adicional (S/)</label>
                @if (esAdmin)
                {
                    <input asp-for="CostoAdicional" type="number" step="0.01" class="input" placeholder="Ej: 50.00 (espera, extras, etc.)" />
                }
                else
                {
                    <input class="input" value="Solo Gina puede fijar el costo adicional" disabled />
                }
            </div>
        </div>

        <h3 class="seccion">Carga</h3>
        <div class="form-grid">
            <div class="form-group">
                <label>Tipo de carga</label>
                <select asp-for="TipoCargamento" class="input">
                    <option value="">-- Selecciona --</option>
                    @foreach (var t in tiposCarga)
                    {
                        <option value="@t">@t</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label>Peso (kg)</label>
                <input asp-for="Peso" type="number" step="0.01" class="input" placeholder="Ej: 850.50" />
            </div>
        </div>

        <h3 class="seccion">Ruta</h3>
        <div class="form-grid">
            <div class="form-group">
                <label>Punto de inicio</label>
                <select asp-for="PuntoInicio" class="input">
                    <option value="">-- Selecciona un distrito --</option>
                    @foreach (var d in distritos)
                    {
                        <option value="@d">@d</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label>Punto final</label>
                <select asp-for="PuntoFin" class="input">
                    <option value="">-- Selecciona un distrito --</option>
                    @foreach (var d in distritos)
                    {
                        <option value="@d">@d</option>
                    }
                </select>
            </div>
        </div>

        <h3 class="seccion">Horarios y kilometraje</h3>
        <div class="form-grid">
            <div class="form-group">
                <label>Fecha y hora de inicio</label>
                <input asp-for="FechaInicio" type="datetime-local" class="input" min="2025-01-01T00:00" />
            </div>

            <div class="form-group">
                <label>Fecha y hora de fin</label>
                <input asp-for="FechaFin" type="datetime-local" class="input" min="2025-01-01T00:00" />
            </div>

            <div class="form-group">
                <label>Kilometraje de inicio de cochera</label>
                <input asp-for="KilometrajeInicioCochera" type="number" class="input" placeholder="Ej: 15180" />
            </div>

            <div class="form-group">
                <label>Kilometraje final de cochera</label>
                <input asp-for="KilometrajeFinalCochera" type="number" class="input" placeholder="Ej: 15360" />
            </div>

            <div class="form-group">
                <label>Kilometraje inicial (del servicio)</label>
                <input asp-for="KilometrajeInicial" type="number" class="input" placeholder="Ej: 15200" />
            </div>

            <div class="form-group">
                <label>Kilometraje final (del servicio)</label>
                <input asp-for="KilometrajeFinal" type="number" class="input" placeholder="Ej: 15340" />
            </div>
        </div>

        <h3 class="seccion">Peaje</h3>
        <div class="form-grid">
            <div class="form-group">
                <label>¿Fuiste por peaje?</label>
                <div style="display:flex; gap:20px; margin-top:6px;">
                    <label style="font-weight:normal;"><input type="radio" name="FuePeaje" value="true" id="peajeSi" /> Sí</label>
                    <label style="font-weight:normal;"><input type="radio" name="FuePeaje" value="false" id="peajeNo" checked /> No</label>
                </div>
            </div>

            <div class="form-group" id="peajeCantidadBox" style="display:none;">
                <label>¿Por cuántos peajes pasó? <span id="peajeCantidadValor">1</span></label>
                <input asp-for="CantidadPeajes" type="range" min="1" max="4" step="1" value="1" class="input" oninput="document.getElementById('peajeCantidadValor').innerText = this.value;" />
            </div>
        </div>

        <h3 class="seccion">Línea amarilla</h3>
        <div class="form-grid">
            <div class="form-group">
                <label>¿Pasaste por línea amarilla?</label>
                <div style="display:flex; gap:20px; margin-top:6px;">
                    <label style="font-weight:normal;"><input type="radio" name="FueLineaAmarilla" value="true" id="lineaSi" /> Sí</label>
                    <label style="font-weight:normal;"><input type="radio" name="FueLineaAmarilla" value="false" id="lineaNo" checked /> No</label>
                </div>
            </div>

            <div class="form-group" id="lineaCantidadBox" style="display:none;">
                <label>¿Por cuántas líneas amarillas pasó? <span id="lineaCantidadValor">1</span></label>
                <input asp-for="CantidadLineaAmarilla" type="range" min="1" max="4" step="1" value="1" class="input" oninput="document.getElementById('lineaCantidadValor').innerText = this.value;" />
            </div>
        </div>

        <div class="form-actions">
            <a href="/Recorrido" class="btn btn-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary">Guardar viaje</button>
        </div>
    </form>
</div>

<script>
    // Si el campo "Fecha y hora de inicio" esta vacio, lo llena con la fecha/hora actual
    // para que el selector del telefono abra en el dia de hoy, no en el ano 1.
    (function () {
        var campo = document.querySelector('input[name="FechaInicio"]');
        if (campo && !campo.value) {
            var ahora = new Date(Date.now() - new Date().getTimezoneOffset() * 60000);
            campo.value = ahora.toISOString().slice(0, 16);
        }
    })();

    // Muestra/oculta la barra de cantidad de peajes segun la respuesta Si/No
    (function () {
        function actualizarPeaje() {
            var si = document.getElementById('peajeSi').checked;
            document.getElementById('peajeCantidadBox').style.display = si ? 'block' : 'none';
        }
        document.getElementById('peajeSi').addEventListener('change', actualizarPeaje);
        document.getElementById('peajeNo').addEventListener('change', actualizarPeaje);
        actualizarPeaje();
    })();

    // Muestra/oculta la barra de cantidad de linea amarilla segun la respuesta Si/No
    (function () {
        function actualizarLinea() {
            var si = document.getElementById('lineaSi').checked;
            document.getElementById('lineaCantidadBox').style.display = si ? 'block' : 'none';
        }
        document.getElementById('lineaSi').addEventListener('change', actualizarLinea);
        document.getElementById('lineaNo').addEventListener('change', actualizarLinea);
        actualizarLinea();
    })();
</script>
